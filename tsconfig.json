{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": "dist",
    "rootDir": ".",
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "//": "浏览器半 `src/client/` 走另一个编译面（DOM lib、无 node 类型），见 tsconfig.client.json。这里必须 exclude，否则 node 面会拿 ES2022 lib 去编译它，Document/HTMLElement 全都不存在。",
  "exclude": ["src/client/**"]
}
