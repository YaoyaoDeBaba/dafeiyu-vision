{
  "name": "dsh-vision-dafeiyu",
  "version": "0.5.0",
  "description": "大肥鱼-识图 + 鲸鱼做梦（独立插件）：外挂视觉模型的配置/识图路由与工具；「鲸鱼做梦」下两条生成通道（小云雀 CLI / 即梦 CLI）的生图/生视频工具；以及设置页「肥鱼识图」「鲸鱼做梦」两个分栏。包名、路由前缀与存储目录与大肥鱼本体完全一致（零迁移）。",
  "type": "module",
  "license": "MIT",
  "main": "./dist/bundle/index.js",
  "exports": {
    ".": "./dist/bundle/index.js",
    "./client": "./dist/bundle/client.cjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "assets",
    "dist/bundle",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "//engines": "网页版识图那部分用宿主全局 WebSocket，要求 Node >= 22（见 README 7.x）；其余功能 >= 20 即可。",
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.client.json",
    "build": "node .bin-build.mjs",
    "test": "npm run build && node --test \"dist/tests/*.test.js\"",
    "check": "node .check-dist.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3"
  }
}
